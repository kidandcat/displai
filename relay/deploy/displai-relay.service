[Unit]
Description=DisplAI relay (pairs the desktop with its phone remote)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=displai-relay
Group=displai-relay
ExecStart=/opt/displai-relay/displai-relay -addr 127.0.0.1:8094
Restart=always
RestartSec=3
MemoryMax=128M
MemorySwapMax=0
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
